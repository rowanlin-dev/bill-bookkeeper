# Bill-Bookkeeper 配置模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，禁止提交

# AI 提供商（目前支持 deepseek）
AI_PROVIDER=deepseek
# 你的 DeepSeek API Key（https://platform.deepseek.com 申请）
AI_API_KEY=sk-在这里填入你的Key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 视觉模型（智谱 GLM，OpenAI 兼容；用于图片记账）
# Key 在 https://open.bigmodel.cn 申请（id.secret 两段式）
VISION_API_KEY=在这里填入你的Key.id
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_MODEL=glm-4.6v-flash

# 后端与 AI 服务之间的内部通信密钥（本地随机字符串即可）
AI_MASTER_KEY=bill-local-key
