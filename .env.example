# Bill-Bookkeeper 配置模板
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，禁止提交

# AI 提供商（目前支持 deepseek）
AI_PROVIDER=deepseek
# 你的 DeepSeek API Key（https://platform.deepseek.com 申请）
AI_API_KEY=sk-在这里填入你的Key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 后端与 AI 服务之间的内部通信密钥（本地随机字符串即可）
AI_MASTER_KEY=bill-local-key
